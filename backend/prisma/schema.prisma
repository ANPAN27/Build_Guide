generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  HOMEOWNER
  PROVIDER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InquiryStatus {
  OPEN
  RESPONDED
  CLOSED
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
  REMOVED
}

model User {
  id                String            @id @default(uuid()) @db.Uuid
  email             String            @unique @db.Citext
  passwordHash      String
  role              UserRole          @default(HOMEOWNER)
  name              String
  phone             String?
  isEmailVerified   Boolean           @default(false)
  emailVerifiedAt   DateTime?
  failedLoginCount  Int               @default(0)
  lockoutUntil      DateTime?
  lastLoginAt       DateTime?
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  providerProfile   ProviderProfile?
  sessions          Session[]
  emailTokens       EmailVerificationToken[]
  passwordResets    PasswordResetToken[]
  reviews           Review[]          @relation("UserReviews")
  moderatedReviews  Review[]          @relation("ReviewModerator")
  favorites         Favorite[]
  inquiries         ContactInquiry[]  @relation("InquiryHomeowner")
  auditLogs         AuditLog[]        @relation("AuditActor")
  verificationDecisions ProviderVerification[] @relation("VerificationReviewer")
  inquiryResponses  ContactInquiry[]  @relation("InquiryResponder")

  @@index([role])
  @@index([createdAt])
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  csrfToken  String
  expiresAt  DateTime
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ProviderProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @db.Uuid
  displayName        String
  specialty          String
  city               String
  experienceYears    Int                @default(0)
  bio                String             @default("")
  rateRange          String?
  phone              String?
  whatsapp           String?
  publicEmail        String?
  website            String?
  address            String?
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  ratingAverage      Decimal            @default(0) @db.Decimal(3, 2)
  reviewCount        Int                @default(0)
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  services           ProviderService[]
  portfolios         ProviderPortfolio[]
  verifications      ProviderVerification[]
  reviews            Review[]
  favorites          Favorite[]
  inquiries          ContactInquiry[]

  @@index([city])
  @@index([specialty])
  @@index([isVerified])
  @@index([verificationStatus])
  @@index([ratingAverage])
}

model ProfessionalCategory {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @unique
  slug        String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  services    ProviderService[]
}

model ProviderService {
  id          String               @id @default(uuid()) @db.Uuid
  providerId  String               @db.Uuid
  categoryId  String?              @db.Uuid
  name        String
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  provider    ProviderProfile      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category    ProfessionalCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([providerId, name])
  @@index([providerId])
}

model ProviderPortfolio {
  id          String          @id @default(uuid()) @db.Uuid
  providerId  String          @db.Uuid
  title       String
  description String?
  imageUrl    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

model ProviderVerification {
  id           String             @id @default(uuid()) @db.Uuid
  providerId   String             @db.Uuid
  status       VerificationStatus @default(PENDING)
  notes        String?
  submittedAt  DateTime           @default(now())
  reviewedAt   DateTime?
  reviewedById String?            @db.Uuid
  createdAt    DateTime           @default(now())

  provider     ProviderProfile    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reviewedBy   User?              @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([providerId])
  @@index([status])
}

model Review {
  id            String          @id @default(uuid()) @db.Uuid
  providerId    String          @db.Uuid
  authorId      String          @db.Uuid
  rating        Int
  title         String?
  body          String
  status        ReviewStatus    @default(VISIBLE)
  moderatedById String?         @db.Uuid
  moderatedAt   DateTime?
  moderationNote String?
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  provider      ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  author        User            @relation("UserReviews", fields: [authorId], references: [id], onDelete: Cascade)
  moderatedBy   User?           @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@unique([providerId, authorId])
  @@index([providerId, status])
  @@index([authorId])
}

model Favorite {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @db.Uuid
  providerId String          @db.Uuid
  createdAt  DateTime        @default(now())

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@index([userId])
}

model ContactInquiry {
  id            String          @id @default(uuid()) @db.Uuid
  providerId    String          @db.Uuid
  homeownerId   String?         @db.Uuid
  name          String
  email         String
  phone         String?
  message       String
  status        InquiryStatus   @default(OPEN)
  respondedAt   DateTime?
  respondedById String?         @db.Uuid
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  provider      ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  homeowner     User?           @relation("InquiryHomeowner", fields: [homeownerId], references: [id], onDelete: SetNull)
  respondedBy   User?           @relation("InquiryResponder", fields: [respondedById], references: [id], onDelete: SetNull)

  @@index([providerId])
  @@index([homeownerId])
  @@index([status])
}

model ConstructionEstimate {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @db.Uuid
  city           String
  areaSqFt       Decimal  @db.Decimal(12, 2)
  floors         Int
  quality        String
  includeInterior Boolean @default(false)
  totalEstimate  Decimal  @db.Decimal(14, 2)
  breakdown      Json
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}
