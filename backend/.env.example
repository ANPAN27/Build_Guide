# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Frontend
FRONTEND_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/build_guide?schema=public

# Auth / Sessions
SESSION_COOKIE_NAME=bg_session
SESSION_TTL_DAYS=7
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
CSRF_COOKIE_NAME=bg_csrf

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Build Guide <noreply@example.com>"
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Security / rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Optional: enable secure cookies behind HTTPS/proxy in production
TRUST_PROXY=true
